{
  "name": "neko",
  "description": "A project of vuepress-theme-hope",
  "version": "2.0.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "scripts": {
    "sync": "node neko-shared/sync.mjs && node scripts/build-command-catalog.mjs",
    "lint:lines": "node scripts/check-lines.mjs",
    "docs:build": "npm run sync && vuepress-vite build src",
    "docs:clean-dev": "npm run sync && vuepress-vite dev src --clean-cache",
    "docs:dev": "npm run sync && vuepress-vite dev src",
    "docs:update-package": "npx vp-update"
  },
  "devDependencies": {
    "@moefy-canvas/theme-popper": "^0.5.2",
    "@vuepress/bundler-vite": "2.0.0-rc.31",
    "@vuepress/plugin-llms": "2.0.0-rc.134",
    "@vuepress/plugin-pwa": "2.0.0-rc.134",
    "@vuepress/plugin-slimsearch": "2.0.0-rc.134",
    "@waline/client": "^3.3.2",
    "clipboard": "^2.0.11",
    "sass-embedded": "^1.104.0",
    "vue": "^3.5.10",
    "vuepress": "2.0.0-rc.31",
    "vuepress-theme-hope": "2.0.0-rc.109"
  },
  "dependencies": {
    "vuepress-plugin-remove-html-extension": "^1.26.0"
  }
}
